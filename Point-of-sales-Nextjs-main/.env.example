# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Supabase Auth - safe for browser/client usage
# Get these from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# New Supabase projects may call this the publishable key. Either name works in the app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only manual activation secret.
# Use this only from trusted admin scripts/tools. Never expose it in NEXT_PUBLIC_*.
VERNEX_ADMIN_SECRET="change-this-long-random-secret"

# Important:
# - Do NOT put Supabase service_role keys in NEXT_PUBLIC_* variables.
# - Do NOT put VERNEX_ADMIN_SECRET in frontend code or NEXT_PUBLIC_* variables.
# - The local demo owner fallback works only in development.
# - Production requires a valid Supabase Auth session and active StaffProfile.

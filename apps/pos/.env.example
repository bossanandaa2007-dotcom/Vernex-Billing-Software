# Supabase Auth - safe for browser/client usage
# Get these from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only manual activation secret.
# Use this only from trusted admin scripts/tools. Never expose it in NEXT_PUBLIC_*.
VERNEX_ADMIN_SECRET="change-this-long-random-secret"

# Server-only. Required by the Super Admin portal, including approving
# subscription payments (approval writes across tenants and bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# The single login allowed into /super-admin. Must match a real Supabase Auth user.
SUPER_ADMIN_EMAIL="you@example.com"

# --- Razorpay (subscription checkout) --------------------------------------
# Server-only. Razorpay Dashboard > Settings > API Keys. Use test keys
# (rzp_test_...) until you are ready to take real money.
# Until BOTH are set, the /subscription page shows "payments not configured"
# instead of a Pay button — nothing crashes.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Razorpay Dashboard > Settings > Webhooks. Create a webhook pointing at
#   https://your-domain/api/webhooks/razorpay
# subscribed to payment.captured and payment.failed, and paste its secret here.
# This is what activates a licence if the customer closes the tab mid-payment.
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Business name shown inside the Razorpay payment dialog.
NEXT_PUBLIC_VERNEX_ACCOUNT_NAME="Vernex Business Suite"

# Important:
# - Do NOT put Supabase service_role keys in NEXT_PUBLIC_* variables.
# - Do NOT put VERNEX_ADMIN_SECRET in frontend code or NEXT_PUBLIC_* variables.
# - The local development owner fallback works only in development.
# - Production requires a valid Supabase Auth session and active StaffProfile.
